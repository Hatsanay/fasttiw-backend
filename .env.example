PORT=3003

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tiwwai

JWT_SECRET=change_me
JWT_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:3000
STORE_URL=http://localhost:3001

# ── เข้าสู่ระบบด้วย Google (ฝั่งลูกค้า) ──────────────────────────────────────
# ไม่ตั้งค่า = ระบบทำงานปกติ ปุ่ม Google แค่ไม่ขึ้น (ต้องตั้ง GOOGLE_CLIENT_ID ฝั่ง tiwwai-store ด้วยปุ่มถึงจะขึ้น)
# สร้างที่ Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI ต้องเป็น  <STORE_URL>/api/auth/google/callback  ตรงทุกตัวอักษร
# client secret อยู่ที่ backend ที่เดียว (ฝั่ง Next ถือแค่ client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# redirect URI เพิ่มเติมที่ยอมรับ คั่นด้วย , (เช่น ทดสอบบนโดเมน staging) — ปกติเว้นว่าง
GOOGLE_EXTRA_REDIRECT_URIS=

# ── อีเมล (SMTP) ────────────────────────────────────────────────────────────
# ไม่ตั้งค่า = ระบบทำงานปกติทุกอย่าง แค่ไม่ส่งอีเมล (ขึ้น warning ใน log เฉยๆ ไม่ throw)
# ใช้ได้กับผู้ให้บริการเจ้าไหนก็ได้ที่มี SMTP เช่น Gmail (app password), Brevo, Amazon SES, Resend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fasttiw <no-reply@fasttiw.com>
MAIL_REPLY_TO=

# ── แจ้งเตือนแชทลูกค้าทาง Telegram ────────────────────────────────────────
# ไม่ตั้งค่า = แชทใช้งานได้ปกติ แค่ไม่มีแจ้งเตือน / วิธีหา chat id: npm run telegram:setup
# สร้าง bot ที่ @BotFather ใน Telegram → ได้ token / chat id ของกลุ่มจะติดลบ (เช่น -1001234567890)
# ส่งหลายที่พร้อมกันได้ คั่นด้วย ,
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ยืนยันว่า header x-client-ip มาจากเซิร์ฟเวอร์ Next ของเราจริง — ตั้งค่าเดียวกันทั้ง backend และ tiwwai-store
# ไม่ตั้ง = rate limit ยังทำงาน แต่จะนับรวมทุกคนเป็น IP เดียว (หยาบกว่า)
INTERNAL_PROXY_SECRET=
